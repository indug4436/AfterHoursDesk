# AfterHoursDesk — copy to .env and fill as needed.
# Mock path works with no keys (LABELED MOCK LLM + DATA + MARKET + SKILLS).

PORT=3010

# OpenAI-compatible LLM (optional — Bitget Qwen / OpenAI / compatible proxy)
# Without these → LABELED MOCK synthesis from fixtures
LLM_API_KEY=
LLM_BASE_URL=https://hackathon.bitgetops.com/v1
# Official Bitget S2: model id qwen3.8-max (OpenAI-compatible /v1)
LLM_MODEL=qwen3.8-max

# News (optional — without → LABELED MOCK headlines)
# Live news path: set a real key below. Partial mode OK if only one of NEWS/LLM is set.
NEWS_API_KEY=
# Set to 0 to force LABELED MOCK news even when NEWS_API_KEY is present
NEWS_LIVE=0

# Market print (optional) — Stooq is default (no key). Yahoo chart free public fallback.
# Finnhub free tier if you have a key:
FINNHUB_API_KEY=

# Bitget public market-data MCP (NO account key) — research Skills live path
# Default always tried when unset. Soft-fails to LABELED MOCK if unreachable.
BITGET_DATAHUB_MCP=https://datahub.noxiaohao.com/mcp
# Legacy Hub URL (optional; ignored for live Skills if not an MCP endpoint)
# BITGET_HUB_URL=
# BITGET_HUB_TOKEN=
# BITGET_SKILLS_URL=
# AGENT_HUB_URL=

# Trading keys not required for Desk research demo (paper/order stays stub)
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_PASSPHRASE=
